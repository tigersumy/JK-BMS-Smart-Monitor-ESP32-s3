{
  "name": "microlink",
  "version": "2.0.0",
  "dependencies": {
    "wireguard_lwip": "*"
  },
  "build": {
    "flags": [
      "-Iinclude",
      "-Isrc",
      "-I../wireguard_lwip/src",
      "-DCONFIG_ML_MAX_PEERS=16",
      "-DCONFIG_ML_NVS_MAX_PEERS=64",
      "-DCONFIG_ML_H2_BUFFER_SIZE_KB=256",
      "-DCONFIG_ML_JSON_BUFFER_SIZE_KB=256"
    ]
  }
}
